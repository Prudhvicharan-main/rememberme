{
  "expo": {
    "name": "RememberMe",
    "slug": "rememberme",
    "version": "1.0.3",
    "icon": "./assets/icon.png.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "rememberme",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rememberme.app"
    },
    "android": {
      "package": "com.rememberme.app",
      "icon": "./assets/icon.png.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#8B5CF6",
          "defaultChannel": "default"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "fe955aff-06c5-4b82-8035-69be8b73b9ce"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/fe955aff-06c5-4b82-8035-69be8b73b9ce"
    }
  }
}
